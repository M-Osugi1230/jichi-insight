{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/sagamihara_phase13_completion.schema.json",
  "title": "Sagamihara Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "sagamihara-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "141500"
    },
    "name_ja": {
      "const": "相模原市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "current_progress_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/sagamihara_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/sagamihara-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/sagamihara_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/sagamihara_current_policy_structure.json"
        },
        "current_progress_review_path": {
          "const": "data/catalog/sagamihara_current_progress_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/sagamihara-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/sagamihara-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_vision_groups",
            "current_measures_aggregate",
            "current_priority_themes",
            "current_progress_measures_covered",
            "evaluation_role_count",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_vision_groups": {
              "const": 6
            },
            "current_measures_aggregate": {
              "const": 47
            },
            "current_priority_themes": {
              "const": 3
            },
            "current_progress_measures_covered": {
              "const": 47
            },
            "evaluation_role_count": {
              "const": 3
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "current-measure-detail",
              "rolling-program-project-detail",
              "citizen-survey-detail",
              "basic-plan-program-next-plan-version-transition",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "measure_count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 250
    }
  }
}
