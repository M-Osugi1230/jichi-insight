{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 normalized record linkage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "prefecture_code",
    "source_registry",
    "source_record_id",
    "linkage_kind",
    "linkage_status",
    "partial_reason",
    "subject",
    "measurements",
    "evidence",
    "boundary",
    "evaluation_status",
    "comparability_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^phase11-record-[a-z0-9-]+$"
    },
    "prefecture_code": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "source_registry": {
      "type": "string",
      "pattern": "^data/catalog/.+\\.json$"
    },
    "source_record_id": {"type": "string", "minLength": 5},
    "linkage_kind": {
      "enum": [
        "target_to_annual_actual",
        "policy_measure_to_project_money",
        "project_to_contract",
        "target_to_accountability"
      ]
    },
    "linkage_status": {
      "enum": ["linked", "partial", "not_linked"]
    },
    "partial_reason": {"type": ["string", "null"]},
    "subject": {"$ref": "#/$defs/subject"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "boundary": {"type": "string", "minLength": 30},
    "evaluation_status": {"const": "not_assessed"},
    "comparability_status": {"const": "excluded_until_verified"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"linkage_status": {"const": "linked"}},
        "required": ["linkage_status"]
      },
      "then": {"properties": {"partial_reason": {"const": null}}}
    },
    {
      "if": {
        "properties": {"linkage_status": {"const": "partial"}},
        "required": ["linkage_status"]
      },
      "then": {
        "properties": {
          "partial_reason": {"type": "string", "minLength": 3}
        }
      }
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "sequence",
        "name",
        "source_name",
        "definition",
        "hierarchy_refs"
      ],
      "properties": {
        "record_ref": {"type": "string", "minLength": 3},
        "sequence": {"type": ["integer", "null"], "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "definition": {"type": "string"},
        "hierarchy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "unit", "value_text", "value", "value_status"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "value_text": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "value_status": {"enum": ["numeric", "textual"]}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status",
        "period_text",
        "value_text",
        "components"
      ],
      "properties": {
        "role": {
          "enum": [
            "plan_current",
            "intermediate_target",
            "final_target",
            "annual_actual",
            "budget",
            "settlement",
            "project_cost",
            "contract_amount"
          ]
        },
        "status": {
          "enum": [
            "reported",
            "available",
            "available_raw_only",
            "not_available",
            "not_promoted"
          ]
        },
        "period_text": {"type": "string"},
        "value_text": {"type": "string"},
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_number", "page", "is_reprint"],
      "properties": {
        "source_number": {"type": "integer", "minimum": 1},
        "page": {"type": "integer", "minimum": 1},
        "is_reprint": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source_number", "primary_page", "locations"],
      "properties": {
        "primary_source_number": {"type": ["integer", "null"], "minimum": 1},
        "primary_page": {"type": ["integer", "null"], "minimum": 1},
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/location"}
        }
      }
    }
  }
}
