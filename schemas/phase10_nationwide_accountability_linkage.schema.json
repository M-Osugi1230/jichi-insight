{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 10 nationwide accountability linkage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "scope_version",
    "completion_definition",
    "roles",
    "records",
    "summary",
    "policy_achievement_assessment_status",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase10-nationwide-accountability-linkage"},
    "phase": {"const": 10},
    "status": {"const": "complete"},
    "scope_version": {"type": "string", "format": "date"},
    "completion_definition": {"type": "string", "minLength": 150},
    "roles": {"const": ["contracts", "assembly", "executive_manifesto"]},
    "records": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": {"$ref": "#/$defs/record"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefecture_count",
        "reviewed_role_count",
        "source_registered_count",
        "term_verification_required_count",
        "no_stable_primary_source_found_count",
        "source_registered_by_role",
        "nonexistence_claim_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "prefecture_count": {"const": 47},
        "reviewed_role_count": {"const": 141},
        "source_registered_count": {"type": "integer", "minimum": 0, "maximum": 141},
        "term_verification_required_count": {"type": "integer", "minimum": 0, "maximum": 47},
        "no_stable_primary_source_found_count": {"type": "integer", "minimum": 0, "maximum": 141},
        "source_registered_by_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contracts", "assembly", "executive_manifesto"],
          "properties": {
            "contracts": {"type": "integer", "minimum": 0, "maximum": 47},
            "assembly": {"type": "integer", "minimum": 0, "maximum": 47},
            "executive_manifesto": {"const": 0}
          }
        },
        "nonexistence_claim_count": {"const": 0},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "policy_achievement_assessment_status": {"const": "not_assessed"},
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "url", "http_status", "discovery_query"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "http_status": {"enum": [200, 206]},
        "discovery_query": {"type": "string", "minLength": 5}
      }
    },
    "roleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "checked_official_hosts",
        "search_query",
        "searched_at",
        "review_status",
        "nonexistence_claim",
        "policy_achievement_assessment",
        "linkage_status",
        "result_status",
        "source",
        "review_note",
        "next_action"
      ],
      "properties": {
        "role": {"enum": ["contracts", "assembly", "executive_manifesto"]},
        "checked_official_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 4}
        },
        "search_query": {"type": "string", "minLength": 5},
        "searched_at": {"type": "string", "format": "date"},
        "review_status": {"const": "reviewed"},
        "nonexistence_claim": {"const": false},
        "policy_achievement_assessment": {"const": "not_assessed"},
        "linkage_status": {"enum": ["source_linked", "search_outcome_linked"]},
        "result_status": {
          "enum": [
            "source_registered",
            "term_verification_required",
            "no_stable_primary_source_found"
          ]
        },
        "source": {"$ref": "#/$defs/source"},
        "review_note": {"type": "string", "minLength": 60},
        "next_action": {"type": "string", "minLength": 60}
      },
      "allOf": [
        {
          "if": {"properties": {"result_status": {"const": "source_registered"}}},
          "then": {
            "properties": {
              "linkage_status": {"const": "source_linked"},
              "source": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"result_status": {"const": "no_stable_primary_source_found"}}},
          "then": {
            "properties": {
              "linkage_status": {"const": "search_outcome_linked"},
              "source": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"result_status": {"const": "term_verification_required"}}},
          "then": {
            "properties": {
              "role": {"const": "executive_manifesto"},
              "linkage_status": {"const": "search_outcome_linked"},
              "source": {"type": "object"}
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefecture_code", "name", "status", "roles"],
      "properties": {
        "prefecture_code": {"type": "string", "pattern": "^(0[1-9]|[1-3][0-9]|4[0-7])$"},
        "name": {"type": "string", "minLength": 2},
        "status": {"const": "complete"},
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contracts", "assembly", "executive_manifesto"],
          "properties": {
            "contracts": {"$ref": "#/$defs/roleResult"},
            "assembly": {"$ref": "#/$defs/roleResult"},
            "executive_manifesto": {"$ref": "#/$defs/roleResult"}
          }
        }
      }
    }
  }
}
