{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/phase15_source_catalog.schema.json",
  "title": "Phase 15 municipality reviewed source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "official_code",
    "name_ja",
    "reviewed_at",
    "records",
    "quality_boundary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-phase15-sources$"
    },
    "phase": {
      "const": 15
    },
    "official_code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "name_ja": {
      "type": "string",
      "minLength": 2
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "records": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "title",
          "organization",
          "url",
          "source_kind",
          "review_status",
          "confidence",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "layer": {
            "type": "string",
            "minLength": 4
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "organization": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_kind": {
            "enum": [
              "html",
              "pdf"
            ]
          },
          "fiscal_year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "effective_period": {
            "type": "string",
            "minLength": 4
          },
          "review_status": {
            "type": "string",
            "pattern": "^reviewed_[a-z0-9_]+$"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "not_assessable"
            ]
          },
          "boundary": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "quality_boundary": {
      "type": "string",
      "minLength": 150
    }
  }
}
