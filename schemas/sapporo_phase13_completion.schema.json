{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/sapporo_phase13_completion.schema.json",
  "title": "Sapporo Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "status", "official_code", "name_ja", "completed_at", "completion_depth", "review_package", "publication_boundary", "quality_gate", "deferred_depth", "completion_boundary"],
  "properties": {
    "id": {"const": "sapporo-phase13-completion"},
    "phase": {"const": 13},
    "status": {"const": "reviewed_complete"},
    "official_code": {"const": "011002"},
    "name_ja": {"const": "札幌市"},
    "completed_at": {"type": "string", "format": "date"},
    "completion_depth": {"const": "declared_review_package_v1"},
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_review_manifest_path", "completion_readiness_path", "plan_review_path", "source_catalog_path", "action_plan_project_source_index_path", "outcome_indicator_registry_path", "outcome_measurement_registry_path", "target_universe_registry_path", "current_target_review_path", "target_publication_boundary_audit_path", "historical_target_review_path", "fiscal_records_path", "fiscal_evidence_path", "counts"],
      "properties": {
        "policy_review_manifest_path": {"const": "data/catalog/sapporo_phase13_policy_review_manifest.json"},
        "completion_readiness_path": {"const": "data/catalog/sapporo_phase13_completion_readiness.json"},
        "plan_review_path": {"const": "data/reviewed/sapporo-city/plan_review.json"},
        "source_catalog_path": {"const": "data/catalog/sapporo_policy_sources.json"},
        "action_plan_project_source_index_path": {"const": "data/catalog/sapporo_action_plan_project_source_index.json"},
        "outcome_indicator_registry_path": {"const": "data/catalog/sapporo_outcome_indicator_registry.json"},
        "outcome_measurement_registry_path": {"const": "data/catalog/sapporo_outcome_indicator_measurement_registry.json"},
        "target_universe_registry_path": {"const": "data/catalog/sapporo_principal_project_target_universe_registry.json"},
        "current_target_review_path": {"const": "data/catalog/sapporo_principal_project_target_2025_review_batch1.json"},
        "target_publication_boundary_audit_path": {"const": "data/catalog/sapporo_principal_project_target_publication_boundary_audit.json"},
        "historical_target_review_path": {"const": "data/catalog/sapporo_principal_project_target_2024_review.json"},
        "fiscal_records_path": {"const": "data/reviewed/sapporo-city/fiscal_records.json"},
        "fiscal_evidence_path": {"const": "data/reviewed/sapporo-city/evidence_packets.json"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_plan_project_identities", "action_plan_main_projects", "action_plan_other_projects", "outcome_indicators", "outcome_objective_or_administrative_lane", "outcome_self_report_lane", "principal_project_target_universe", "current_individual_target_statuses_reviewed", "current_individual_target_statuses_deferred_at_central_publication_boundary", "fiscal_top_line_records"],
          "properties": {
            "action_plan_project_identities": {"const": 599},
            "action_plan_main_projects": {"const": 406},
            "action_plan_other_projects": {"const": 193},
            "outcome_indicators": {"const": 26},
            "outcome_objective_or_administrative_lane": {"const": 12},
            "outcome_self_report_lane": {"const": 14},
            "principal_project_target_universe": {"const": 403},
            "current_individual_target_statuses_reviewed": {"const": 8},
            "current_individual_target_statuses_deferred_at_central_publication_boundary": {"const": 395},
            "fiscal_top_line_records": {"const": 3}
          }
        }
      }
    },
    "publication_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_path", "central_progress_publication_complete_aggregate_reviewed", "central_progress_publication_complete_identity_status_table_published", "all_named_current_statuses_in_central_progress_publication_reviewed", "reviewed_named_current_status_count", "unresolved_identity_status_count", "unresolved_identity_statuses_required_for_v1_completion", "aggregate_partition_must_not_be_distributed_to_unnamed_projects"],
      "properties": {
        "audit_path": {"const": "data/catalog/sapporo_principal_project_target_publication_boundary_audit.json"},
        "central_progress_publication_complete_aggregate_reviewed": {"const": true},
        "central_progress_publication_complete_identity_status_table_published": {"const": false},
        "all_named_current_statuses_in_central_progress_publication_reviewed": {"const": true},
        "reviewed_named_current_status_count": {"const": 8},
        "unresolved_identity_status_count": {"const": 395},
        "unresolved_identity_statuses_required_for_v1_completion": {"const": false},
        "aggregate_partition_must_not_be_distributed_to_unnamed_projects": {"const": true}
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 10,
      "patternProperties": {"^[a-z0-9_]+$": {"const": true}}
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "boundary"],
        "properties": {
          "id": {"enum": ["principal-project-target-current-statuses-beyond-central-publication", "outcome-indicator-exact-instrument-provenance", "fiscal-detail-project-linkage", "project-outcome-causal-assessment"]},
          "status": {"const": "deferred_not_required_for_v1_completion"},
          "count": {"type": "integer", "minimum": 0},
          "boundary": {"type": "string", "minLength": 20}
        }
      }
    },
    "completion_boundary": {"type": "string", "minLength": 150}
  }
}
