{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Niigata maximum-depth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "phase", "status", "prefecture_code", "source_catalog",
    "normalizer", "shared_normalizer", "record_schema",
    "expected_normalization", "source_gap", "maximum_depth_rule",
    "source_gap_boundary", "version_boundary", "non_goals", "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-niigata-normalization"},
    "phase": {"const": 11},
    "status": {"const": "reviewed_maximum_depth_with_source_gap"},
    "prefecture_code": {"const": "15"},
    "source_catalog": {"const": "data/reviewed/phase9/15.json"},
    "normalizer": {"const": "scripts/normalize_phase11_niigata.py"},
    "shared_normalizer": {"const": "scripts/phase11_phase9_raw.py"},
    "record_schema": {"const": "schemas/phase11_record_linkage.schema.json"},
    "expected_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "linked_record_count", "partial_record_count",
        "not_linked_record_count", "indicator_series_count",
        "annual_actual_available_count", "future_target_available_count",
        "reviewed_maximum_depth_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 89},
        "linked_record_count": {"const": 0},
        "partial_record_count": {"const": 89},
        "not_linked_record_count": {"const": 0},
        "indicator_series_count": {"const": 89},
        "annual_actual_available_count": {"const": 0},
        "future_target_available_count": {"const": 0},
        "reviewed_maximum_depth_record_count": {"const": 89},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "source_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_document_count", "registered_document_count",
        "unresolved_document_count", "extraction_error_count",
        "resolution_status"
      ],
      "properties": {
        "selected_document_count": {"const": 2},
        "registered_document_count": {"const": 1},
        "unresolved_document_count": {"const": 1},
        "extraction_error_count": {"const": 1},
        "resolution_status": {"const": "explicitly_unresolved"}
      }
    },
    "maximum_depth_rule": {"type": "string", "minLength": 160},
    "source_gap_boundary": {"type": "string", "minLength": 170},
    "version_boundary": {"type": "string", "minLength": 165},
    "non_goals": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 30}
    },
    "updated_at": {"type": "string", "format": "date"}
  }
}
