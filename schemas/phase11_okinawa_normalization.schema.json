{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Okinawa maximum-depth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "phase", "status", "prefecture_code", "source_catalogs",
    "source_review_manifest", "normalizer", "record_schema",
    "expected_normalization", "maximum_depth_rule", "reference_boundary",
    "non_goals", "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-okinawa-normalization"},
    "phase": {"const": 11},
    "status": {"const": "reviewed_maximum_depth"},
    "prefecture_code": {"const": "47"},
    "source_catalogs": {
      "const": [
        "data/reviewed/okinawa_midterm_major_indicators.json",
        "data/reviewed/okinawa_midterm_outcome_indicators_part1.json",
        "data/reviewed/okinawa_midterm_outcome_indicators_part2.json",
        "data/reviewed/okinawa_midterm_outcome_indicators_part3.json"
      ]
    },
    "source_review_manifest": {"const": "data/catalog/okinawa_midterm_indicator_review_manifest.json"},
    "normalizer": {"const": "scripts/normalize_phase11_okinawa.py"},
    "record_schema": {"const": "schemas/phase11_record_linkage.schema.json"},
    "expected_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "linked_record_count", "partial_record_count",
        "not_linked_record_count", "major_indicator_count",
        "outcome_indicator_count", "indicator_series_count",
        "annual_actual_available_count", "annual_actual_unavailable_count",
        "island_indicator_count", "sdgs_priority_indicator_count",
        "qualitative_target_count", "national_comparison_provided_count",
        "national_comparison_unavailable_count", "source_value_note_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 375},
        "linked_record_count": {"const": 0},
        "partial_record_count": {"const": 375},
        "not_linked_record_count": {"const": 0},
        "major_indicator_count": {"const": 36},
        "outcome_indicator_count": {"const": 339},
        "indicator_series_count": {"const": 375},
        "annual_actual_available_count": {"const": 0},
        "annual_actual_unavailable_count": {"const": 375},
        "island_indicator_count": {"const": 32},
        "sdgs_priority_indicator_count": {"const": 43},
        "qualitative_target_count": {"const": 9},
        "national_comparison_provided_count": {"const": 174},
        "national_comparison_unavailable_count": {"const": 201},
        "source_value_note_count": {"const": 1},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "maximum_depth_rule": {"type": "string", "minLength": 100},
    "reference_boundary": {"type": "string", "minLength": 80},
    "non_goals": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 30}
    },
    "updated_at": {"type": "string", "format": "date"}
  }
}
