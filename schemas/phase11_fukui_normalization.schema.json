{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Fukui maximum-depth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "phase", "status", "prefecture_code", "source_catalog",
    "normalizer", "shared_normalizer", "record_schema",
    "expected_normalization", "document_boundary", "maximum_depth_rule",
    "hierarchy_boundary", "evaluation_boundary", "non_goals", "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-fukui-normalization"},
    "phase": {"const": 11},
    "status": {"const": "reviewed_maximum_depth"},
    "prefecture_code": {"const": "18"},
    "source_catalog": {"const": "data/reviewed/phase9/18.json"},
    "normalizer": {"const": "scripts/normalize_phase11_fukui.py"},
    "shared_normalizer": {"const": "scripts/phase11_phase9_raw.py"},
    "record_schema": {"const": "schemas/phase11_record_linkage.schema.json"},
    "expected_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "linked_record_count", "partial_record_count",
        "not_linked_record_count", "indicator_series_count",
        "annual_actual_available_count", "future_target_available_count",
        "reviewed_maximum_depth_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 114},
        "linked_record_count": {"const": 0},
        "partial_record_count": {"const": 114},
        "not_linked_record_count": {"const": 0},
        "indicator_series_count": {"const": 114},
        "annual_actual_available_count": {"const": 0},
        "future_target_available_count": {"const": 0},
        "reviewed_maximum_depth_record_count": {"const": 114},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "document_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_document_count", "document_reviewed_row_counts",
        "document_reviewed_row_total", "canonical_record_count",
        "documents_with_zero_reviewed_rows"
      ],
      "properties": {
        "registered_document_count": {"const": 6},
        "document_reviewed_row_counts": {
          "const": [1, 102, 0, 7, 3, 1]
        },
        "document_reviewed_row_total": {"const": 114},
        "canonical_record_count": {"const": 114},
        "documents_with_zero_reviewed_rows": {"const": 1}
      }
    },
    "maximum_depth_rule": {"type": "string", "minLength": 185},
    "hierarchy_boundary": {"type": "string", "minLength": 190},
    "evaluation_boundary": {"type": "string", "minLength": 120},
    "non_goals": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 30}
    },
    "updated_at": {"type": "string", "format": "date"}
  }
}
