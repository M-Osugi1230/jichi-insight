{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/kyoto_phase13_completion.schema.json",
  "title": "Kyoto Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "kyoto-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "261009"
    },
    "name_ja": {
      "const": "京都市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "strategy_structure_path",
        "progress_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/kyoto_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/kyoto-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/kyoto_phase13_sources.json"
        },
        "strategy_structure_path": {
          "const": "data/catalog/kyoto_current_strategy_structure.json"
        },
        "progress_review_path": {
          "const": "data/catalog/kyoto_current_progress_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/kyoto-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/kyoto-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_strategy_policies",
            "current_strategy_components",
            "strategic_perspectives",
            "historical_basic_plan_policy_fields",
            "accountability_roles",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_strategy_policies": {
              "const": 6
            },
            "current_strategy_components": {
              "const": 3
            },
            "strategic_perspectives": {
              "const": 3
            },
            "historical_basic_plan_policy_fields": {
              "const": 27
            },
            "accountability_roles": {
              "const": 3
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "current-policy-kpi-detail",
              "leading-project-and-policy-catalog-detail",
              "current-progress-record-detail",
              "basic-concept-strategy-linkage",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "policy_count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 300
    }
  }
}
