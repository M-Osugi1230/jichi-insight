{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Ishikawa maximum-depth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "phase", "status", "prefecture_code", "source_catalog",
    "normalizer", "shared_normalizer", "record_schema",
    "expected_normalization", "overlap_boundary", "maximum_depth_rule",
    "hierarchy_boundary", "evaluation_boundary", "non_goals", "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-ishikawa-normalization"},
    "phase": {"const": 11},
    "status": {"const": "reviewed_maximum_depth"},
    "prefecture_code": {"const": "17"},
    "source_catalog": {"const": "data/reviewed/phase9/17.json"},
    "normalizer": {"const": "scripts/normalize_phase11_ishikawa.py"},
    "shared_normalizer": {"const": "scripts/phase11_phase9_raw.py"},
    "record_schema": {"const": "schemas/phase11_record_linkage.schema.json"},
    "expected_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "linked_record_count", "partial_record_count",
        "not_linked_record_count", "indicator_series_count",
        "annual_actual_available_count", "future_target_available_count",
        "reviewed_maximum_depth_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 9},
        "linked_record_count": {"const": 0},
        "partial_record_count": {"const": 9},
        "not_linked_record_count": {"const": 0},
        "indicator_series_count": {"const": 9},
        "annual_actual_available_count": {"const": 0},
        "future_target_available_count": {"const": 0},
        "reviewed_maximum_depth_record_count": {"const": 9},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "overlap_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_document_count", "documents_with_reviewed_rows",
        "documents_used_by_canonical_records", "document_reviewed_row_total",
        "canonical_record_count", "overlap_difference",
        "fully_overlapped_document_count", "documents_with_zero_reviewed_rows"
      ],
      "properties": {
        "registered_document_count": {"const": 6},
        "documents_with_reviewed_rows": {"const": 3},
        "documents_used_by_canonical_records": {"const": 2},
        "document_reviewed_row_total": {"const": 11},
        "canonical_record_count": {"const": 9},
        "overlap_difference": {"const": 2},
        "fully_overlapped_document_count": {"const": 1},
        "documents_with_zero_reviewed_rows": {"const": 3}
      }
    },
    "maximum_depth_rule": {"type": "string", "minLength": 180},
    "hierarchy_boundary": {"type": "string", "minLength": 175},
    "evaluation_boundary": {"type": "string", "minLength": 155},
    "non_goals": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 30}
    },
    "updated_at": {"type": "string", "format": "date"}
  }
}
