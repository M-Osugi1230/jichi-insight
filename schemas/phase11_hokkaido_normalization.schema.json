{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Hokkaido normalization completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "prefecture_code",
    "status",
    "source_catalog",
    "source_files",
    "normalizer",
    "record_schema",
    "regression_test",
    "summary",
    "partial_reason_counts",
    "completion_boundary",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-hokkaido-normalization"},
    "phase": {"const": 11},
    "prefecture_code": {"const": "01"},
    "status": {"const": "complete"},
    "source_catalog": {
      "const": "data/catalog/hokkaido_annual_actual_linkage.json"
    },
    "source_files": {
      "const": [
        "data/catalog/hokkaido_annual_actual_linkage_part_01.json",
        "data/catalog/hokkaido_annual_actual_linkage_part_02.json"
      ]
    },
    "normalizer": {"const": "scripts/normalize_phase11_hokkaido.py"},
    "record_schema": {
      "const": "schemas/phase11_record_linkage.schema.json"
    },
    "regression_test": {
      "const": "tests/test_phase11_hokkaido_normalization.py"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "linked_record_count",
        "partial_record_count",
        "not_linked_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 108},
        "linked_record_count": {"const": 90},
        "partial_record_count": {"const": 18},
        "not_linked_record_count": {"const": 0},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "partial_reason_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_version_changed",
        "unit_scale_changed_or_requires_conversion",
        "indicator_definition_or_numbering_changed",
        "component_structure_changed"
      ],
      "properties": {
        "target_version_changed": {"const": 3},
        "unit_scale_changed_or_requires_conversion": {"const": 3},
        "indicator_definition_or_numbering_changed": {"const": 10},
        "component_structure_changed": {"const": 2}
      }
    },
    "completion_boundary": {"type": "string", "minLength": 180},
    "updated_at": {"type": "string", "format": "date"}
  }
}
