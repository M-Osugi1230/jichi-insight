{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/niigata_phase13_completion.schema.json",
  "title": "Niigata Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "niigata-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "151009"
    },
    "name_ja": {
      "const": "新潟市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "current_progress_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/niigata_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/niigata-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/niigata_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/niigata_current_policy_structure.json"
        },
        "current_progress_review_path": {
          "const": "data/catalog/niigata_current_progress_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/niigata-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/niigata-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_fields",
            "current_policies",
            "current_measures_aggregate",
            "current_priority_strategies",
            "current_sustainable_governance_pillars",
            "current_overall_indicators",
            "current_overall_indicator_results_reviewed",
            "current_policy_indicators_aggregate",
            "accountability_role_count",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_fields": {
              "const": 8
            },
            "current_policies": {
              "const": 16
            },
            "current_measures_aggregate": {
              "const": 45
            },
            "current_priority_strategies": {
              "const": 10
            },
            "current_sustainable_governance_pillars": {
              "const": 3
            },
            "current_overall_indicators": {
              "const": 4
            },
            "current_overall_indicator_results_reviewed": {
              "const": 4
            },
            "current_policy_indicators_aggregate": {
              "const": 87
            },
            "accountability_role_count": {
              "const": 3
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "current-measure-detail",
              "policy-indicator-detail",
              "action-indicator-and-project-detail",
              "midterm-review-final-adoption",
              "second-implementation-plan-version",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 300
    }
  }
}
