{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/nagoya_phase13_completion.schema.json",
  "title": "Nagoya Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "nagoya-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "231002"
    },
    "name_ja": {
      "const": "名古屋市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "current_progress_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/nagoya_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/nagoya-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/nagoya_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/nagoya_current_policy_structure.json"
        },
        "current_progress_review_path": {
          "const": "data/catalog/nagoya_current_progress_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/nagoya-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/nagoya-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_city_visions",
            "current_measures_aggregate",
            "current_outcome_indicators_aggregate",
            "current_listed_projects_aggregate",
            "source_reported_indicator_A_B_C_count",
            "source_reported_projects_four_or_three_stars",
            "citizen_survey_target_population",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_city_visions": {
              "const": 5
            },
            "current_measures_aggregate": {
              "const": 42
            },
            "current_outcome_indicators_aggregate": {
              "const": 135
            },
            "current_listed_projects_aggregate": {
              "const": 506
            },
            "source_reported_indicator_A_B_C_count": {
              "const": 95
            },
            "source_reported_projects_four_or_three_stars": {
              "const": 480
            },
            "citizen_survey_target_population": {
              "const": 4000
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "measure-detail",
              "indicator-detail",
              "listed-project-detail",
              "citizen-survey-detail",
              "project-cost-to-fiscal-linkage",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 300
    }
  }
}
