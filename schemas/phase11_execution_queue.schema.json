{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 execution queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "status", "active_wave", "quality_gate", "waves", "summary", "updated_at"],
  "properties": {
    "id": {"const": "phase11-record-linkage-execution-queue"},
    "phase": {"const": 11},
    "status": {"const": "in_progress"},
    "active_wave": {"const": "wave3-nationwide-minimum-record-depth"},
    "quality_gate": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 20}},
    "waves": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/wave"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total_prefectures", "reference_prefectures", "remaining_anchor_prefectures", "nationwide_prefectures", "wave1_inventory", "wave1_normalization", "wave2_normalization", "wave3_normalization"],
      "properties": {
        "total_prefectures": {"const": 47},
        "reference_prefectures": {"const": 4},
        "remaining_anchor_prefectures": {"const": 5},
        "nationwide_prefectures": {"const": 38},
        "wave1_inventory": {"type": "object", "additionalProperties": false, "required": ["record_files", "records", "linked", "partial", "not_linked"], "properties": {"record_files": {"const": 11}, "records": {"const": 861}, "linked": {"const": 420}, "partial": {"const": 58}, "not_linked": {"const": 383}}},
        "wave1_normalization": {"type": "object", "additionalProperties": false, "required": ["prefectures_complete", "records_complete", "linked_complete", "partial_complete", "not_linked_complete"], "properties": {"prefectures_complete": {"const": 4}, "records_complete": {"const": 861}, "linked_complete": {"const": 420}, "partial_complete": {"const": 58}, "not_linked_complete": {"const": 383}}},
        "wave2_normalization": {"type": "object", "additionalProperties": false, "required": ["anchors_complete", "anchors_remaining", "records_complete", "indicator_series_complete", "linked_current_series", "missing_or_unavailable_current_series", "target_series", "reviewed_maximum_depth_records"], "properties": {"anchors_complete": {"const": 5}, "anchors_remaining": {"const": 0}, "records_complete": {"const": 711}, "indicator_series_complete": {"const": 725}, "linked_current_series": {"const": 340}, "missing_or_unavailable_current_series": {"const": 385}, "target_series": {"const": 602}, "reviewed_maximum_depth_records": {"const": 375}}},
        "wave3_normalization": {"type": "object", "additionalProperties": false, "required": ["prefectures_complete", "prefectures_remaining", "records_complete", "reviewed_maximum_depth_records", "linked_records", "partial_records", "next_prefecture_code"], "properties": {"prefectures_complete": {"const": 32}, "prefectures_remaining": {"const": 6}, "records_complete": {"const": 11506}, "reviewed_maximum_depth_records": {"const": 11506}, "linked_records": {"const": 0}, "partial_records": {"const": 11506}, "next_prefecture_code": {"const": "41"}}}
      }
    },
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "wave": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "prefecture_codes", "objective", "exit_criteria", "next_action"],
      "properties": {
        "id": {"type": "string", "pattern": "^wave[1-3]-[a-z0-9-]+$"},
        "status": {"enum": ["in_progress", "pending", "complete"]},
        "prefecture_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
        "objective": {"type": "string", "minLength": 40},
        "exit_criteria": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 20}},
        "next_action": {"type": "string", "minLength": 30}
      }
    }
  }
}
