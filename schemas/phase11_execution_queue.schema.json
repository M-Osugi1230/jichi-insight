{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 execution queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "status", "active_wave", "quality_gate", "waves", "summary", "updated_at"],
  "properties": {
    "id": {"const": "phase11-record-linkage-execution-queue"},
    "phase": {"const": 11},
    "status": {"const": "in_progress"},
    "active_wave": {"const": "wave1-reference-implementations"},
    "quality_gate": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20}
    },
    "waves": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/wave"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_prefectures", "reference_prefectures", "remaining_anchor_prefectures", "nationwide_prefectures"],
      "properties": {
        "total_prefectures": {"const": 47},
        "reference_prefectures": {"const": 4},
        "remaining_anchor_prefectures": {"const": 5},
        "nationwide_prefectures": {"const": 38}
      }
    },
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "prefecture_codes", "objective", "exit_criteria", "next_action"],
      "properties": {
        "id": {"type": "string", "pattern": "^wave[1-3]-[a-z0-9-]+$"},
        "status": {"enum": ["in_progress", "pending", "complete"]},
        "prefecture_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{2}$"}
        },
        "objective": {"type": "string", "minLength": 40},
        "exit_criteria": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 20}
        },
        "next_action": {"type": "string", "minLength": 30}
      }
    }
  }
}
