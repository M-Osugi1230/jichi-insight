{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 12 Saitama complete official source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","phase","status","official_code","name_ja","prefecture_name_ja","review_status","plan_period","sources","quality_boundary","next_action","verified_at"],
  "properties": {
    "id": {"const": "phase12-saitama-source-inventory"},
    "phase": {"const": 12},
    "status": {"const": "source_inventory_complete"},
    "official_code": {"const": "111007"},
    "name_ja": {"const": "さいたま市"},
    "prefecture_name_ja": {"const": "埼玉県"},
    "review_status": {"const": "indexed_not_reviewed"},
    "plan_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_fiscal_year","end_fiscal_year","current_plan_name"],
      "properties": {
        "start_fiscal_year": {"const": 2021},
        "end_fiscal_year": {"const": 2030},
        "current_plan_name": {"const": "2030さいたま輝く未来と希望のまちプラン"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","layer","title","official_url","status","review_boundary"],
        "properties": {
          "id": {"type": "string","minLength": 5},
          "layer": {"enum": ["comprehensive_plan","implementation_plan","annual_progress","budget","settlement"]},
          "title": {"type": "string","minLength": 4},
          "official_url": {"type": "string","format": "uri","pattern": "^https://www\\.city\\.saitama\\.lg\\.jp/"},
          "status": {"const": "official_landing_verified"},
          "effective_period": {"type": "string","minLength": 8},
          "fiscal_year": {"type": "integer","minimum": 2024,"maximum": 2026},
          "reporting_fiscal_year": {"type": "integer","minimum": 2024,"maximum": 2024},
          "review_boundary": {"type": "string","minLength": 120}
        }
      }
    },
    "quality_boundary": {"type": "string","minLength": 300},
    "next_action": {"type": "string","minLength": 180},
    "verified_at": {"const": "2026-08-08","format": "date"}
  }
}
