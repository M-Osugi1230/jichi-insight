{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Tokyo normalization completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "prefecture_code",
    "status",
    "source_catalog",
    "normalizer",
    "record_schema",
    "regression_test",
    "summary",
    "partial_reason_counts",
    "completion_boundary",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-tokyo-normalization"},
    "phase": {"const": 11},
    "prefecture_code": {"const": "13"},
    "status": {"const": "complete"},
    "source_catalog": {
      "const": "data/catalog/tokyo_children_annual_actual_linkage.json"
    },
    "normalizer": {"const": "scripts/normalize_phase11_tokyo.py"},
    "record_schema": {
      "const": "schemas/phase11_record_linkage.schema.json"
    },
    "regression_test": {
      "const": "tests/test_phase11_tokyo_normalization.py"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "linked_record_count",
        "linked_series_count",
        "partial_record_count",
        "not_linked_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 8},
        "linked_record_count": {"const": 6},
        "linked_series_count": {"const": 7},
        "partial_record_count": {"const": 2},
        "not_linked_record_count": {"const": 0},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "partial_reason_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reporting_period_conflict",
        "actual_value_and_period_conflict"
      ],
      "properties": {
        "reporting_period_conflict": {"const": 1},
        "actual_value_and_period_conflict": {"const": 1}
      }
    },
    "completion_boundary": {"type": "string", "minLength": 200},
    "updated_at": {"type": "string", "format": "date"}
  }
}
