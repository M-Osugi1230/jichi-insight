{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.example/schemas/phase10_anchor_depth_reviews.schema.json",
  "title": "Phase 10 regional anchor depth reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "prefecture_codes",
    "dimensions",
    "records",
    "summary",
    "policy_achievement_assessment_status",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase10-anchor-depth-reviews"},
    "status": {"const": "reviewed"},
    "prefecture_codes": {
      "type": "array",
      "const": ["01", "13", "23", "27", "34", "37", "47"]
    },
    "dimensions": {
      "type": "array",
      "const": [
        "annual_actuals",
        "budget",
        "settlement",
        "priority_projects",
        "audit"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/record"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefecture_count",
        "dimension_count",
        "reviewed_source_count",
        "dimension_reviewed_counts"
      ],
      "properties": {
        "prefecture_count": {"const": 7},
        "dimension_count": {"const": 5},
        "reviewed_source_count": {"const": 35},
        "dimension_reviewed_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annual_actuals",
            "budget",
            "settlement",
            "priority_projects",
            "audit"
          ],
          "properties": {
            "annual_actuals": {"const": 7},
            "budget": {"const": 7},
            "settlement": {"const": 7},
            "priority_projects": {"const": 7},
            "audit": {"const": 7}
          }
        }
      }
    },
    "policy_achievement_assessment_status": {"const": "not_assessed"},
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "official_owner",
        "reporting_period",
        "claim",
        "boundary"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "official_owner": {"type": "string", "minLength": 3},
        "reporting_period": {"type": "string", "minLength": 3},
        "claim": {"type": "string", "minLength": 20},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_actuals",
        "budget",
        "settlement",
        "priority_projects",
        "audit"
      ],
      "properties": {
        "annual_actuals": {"$ref": "#/$defs/source"},
        "budget": {"$ref": "#/$defs/source"},
        "settlement": {"$ref": "#/$defs/source"},
        "priority_projects": {"$ref": "#/$defs/source"},
        "audit": {"$ref": "#/$defs/source"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefecture_code",
        "name",
        "region",
        "sources",
        "next_linkage"
      ],
      "properties": {
        "prefecture_code": {
          "enum": ["01", "13", "23", "27", "34", "37", "47"]
        },
        "name": {
          "enum": [
            "北海道",
            "東京都",
            "愛知県",
            "大阪府",
            "広島県",
            "香川県",
            "沖縄県"
          ]
        },
        "region": {
          "enum": [
            "北海道",
            "関東",
            "中部",
            "近畿",
            "中国",
            "四国",
            "九州・沖縄"
          ]
        },
        "sources": {"$ref": "#/$defs/sources"},
        "next_linkage": {"type": "string", "minLength": 20}
      }
    }
  }
}
