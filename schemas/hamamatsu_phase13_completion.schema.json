{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/hamamatsu_phase13_completion.schema.json",
  "title": "Hamamatsu Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "hamamatsu-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "221309"
    },
    "name_ja": {
      "const": "浜松市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "current_implementation_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/hamamatsu_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/hamamatsu-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/hamamatsu_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/hamamatsu_current_policy_structure.json"
        },
        "current_implementation_review_path": {
          "const": "data/catalog/hamamatsu_current_implementation_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/hamamatsu-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/hamamatsu-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_plan_layers",
            "current_fields",
            "current_basic_policies",
            "current_policies_aggregate",
            "current_outcome_indicators_aggregate",
            "life_satisfaction_indicators_total",
            "life_satisfaction_results_reviewed",
            "current_implementation_year",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_plan_layers": {
              "const": 3
            },
            "current_fields": {
              "const": 7
            },
            "current_basic_policies": {
              "const": 25
            },
            "current_policies_aggregate": {
              "const": 125
            },
            "current_outcome_indicators_aggregate": {
              "const": 38
            },
            "life_satisfaction_indicators_total": {
              "const": 50
            },
            "life_satisfaction_results_reviewed": {
              "const": 15
            },
            "current_implementation_year": {
              "const": 2026
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "outcome-indicator-detail",
              "policy-detail-and-evaluation",
              "individual-life-satisfaction-detail",
              "fy2026-full-year-result",
              "implementation-project-detail",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 300
    }
  }
}
