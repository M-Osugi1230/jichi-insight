{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.example/schemas/fukuoka_annual_actual_linkage_part.schema.json",
  "title": "Fukuoka annual actual linkage part",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "target_number_from", "target_number_to", "records"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fukuoka-prefecture-fy2024-annual-actual-linkage-part-0[1-4]$"
    },
    "target_number_from": {"type": "integer", "minimum": 1, "maximum": 118},
    "target_number_to": {"type": "integer", "minimum": 1, "maximum": 118},
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "linkage_status",
          "match_basis",
          "source_pdf_page",
          "source_initial_value_text",
          "source_target_value_text",
          "actual_value_text",
          "actual_period_text",
          "target_version_status"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^policy-target-fukuoka-prefecture-initiative-[0-9]{2}-[0-9]{2,3}$"
          },
          "linkage_status": {"enum": ["linked", "partial", "not_linked"]},
          "match_basis": {
            "enum": [
              "normalized_indicator_exact",
              "reviewed_alias",
              "not_present_in_fy2024_progress_report"
            ]
          },
          "source_pdf_page": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 61
          },
          "source_initial_value_text": {"type": ["string", "null"]},
          "source_target_value_text": {"type": ["string", "null"]},
          "actual_value_text": {"type": ["string", "null"]},
          "actual_period_text": {"type": ["string", "null"]},
          "target_version_status": {
            "enum": [
              "same_target_definition",
              "revised_target_detected",
              "source_row_not_found"
            ]
          },
          "source_indicator_name": {"type": "string", "minLength": 2},
          "alias_review_note": {"type": "string", "minLength": 5}
        },
        "allOf": [
          {
            "if": {"properties": {"linkage_status": {"const": "linked"}}},
            "then": {
              "properties": {
                "source_pdf_page": {"type": "integer"},
                "source_initial_value_text": {"type": "string"},
                "source_target_value_text": {"type": "string"},
                "actual_value_text": {"type": "string"},
                "actual_period_text": {"type": "string"},
                "target_version_status": {"const": "same_target_definition"}
              }
            }
          },
          {
            "if": {"properties": {"linkage_status": {"const": "partial"}}},
            "then": {
              "properties": {
                "source_pdf_page": {"type": "integer"},
                "source_initial_value_text": {"type": "string"},
                "source_target_value_text": {"type": "string"},
                "actual_value_text": {"type": "string"},
                "actual_period_text": {"type": "string"},
                "target_version_status": {"const": "revised_target_detected"}
              }
            }
          },
          {
            "if": {"properties": {"linkage_status": {"const": "not_linked"}}},
            "then": {
              "properties": {
                "match_basis": {"const": "not_present_in_fy2024_progress_report"},
                "source_pdf_page": {"const": null},
                "source_initial_value_text": {"const": null},
                "source_target_value_text": {"const": null},
                "actual_value_text": {"const": null},
                "actual_period_text": {"const": null},
                "target_version_status": {"const": "source_row_not_found"}
              }
            }
          },
          {
            "if": {"properties": {"match_basis": {"const": "reviewed_alias"}}},
            "then": {"required": ["source_indicator_name", "alias_review_note"]}
          }
        ]
      }
    }
  }
}
