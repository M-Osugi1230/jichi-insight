{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 12 Chiba official source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","phase","status","official_code","name_ja","prefecture_name_ja","review_status","plan_period","sources","quality_boundary","next_action","verified_at"],
  "properties": {
    "id": {"const": "phase12-chiba-source-inventory"},
    "phase": {"const": 12},
    "status": {"const": "source_inventory_complete"},
    "official_code": {"const": "121002"},
    "name_ja": {"const": "千葉市"},
    "prefecture_name_ja": {"const": "千葉県"},
    "review_status": {"const": "indexed_not_reviewed"},
    "plan_period": {"type":"object","additionalProperties":false,"required":["start_fiscal_year","end_fiscal_year","current_plan_name"],"properties":{"start_fiscal_year":{"const":2023},"end_fiscal_year":{"const":2032},"current_plan_name":{"const":"千葉市基本計画"}}},
    "sources": {"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","layer","title","official_url","status","review_boundary"],"properties":{"id":{"type":"string","minLength":5},"layer":{"enum":["comprehensive_plan","implementation_plan","annual_progress","budget","settlement"]},"title":{"type":"string","minLength":3},"official_url":{"type":"string","format":"uri","pattern":"^https://www\\.city\\.chiba\\.jp/"},"status":{"const":"official_landing_verified"},"review_boundary":{"type":"string","minLength":80},"effective_period":{"type":"string"},"available_periods":{"type":"array","minItems":1,"items":{"type":"string"}},"fiscal_year":{"type":"integer","minimum":2000,"maximum":2100}}}},
    "quality_boundary": {"type":"string","minLength":180},
    "next_action": {"type":"string","minLength":150},
    "verified_at": {"const":"2026-08-06","format":"date"}
  }
}
