{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/chiba_versioned_project_linkage.schema.json",
  "title": "Chiba Versioned Project Linkage Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "official_code",
    "name_ja",
    "historical_plan_period",
    "current_plan_period",
    "status",
    "promotion_rule",
    "allowed_relation_types",
    "summary",
    "records",
    "not_promoted_candidates",
    "quality_boundary"
  ],
  "properties": {
    "id": {
      "const": "chiba-versioned-project-linkage-review"
    },
    "phase": {
      "const": 13
    },
    "official_code": {
      "const": "121002"
    },
    "name_ja": {
      "const": "千葉市"
    },
    "historical_plan_period": {
      "const": "2023年度～2025年度"
    },
    "current_plan_period": {
      "const": "2026年度～2028年度"
    },
    "status": {
      "enum": [
        "versioned_linkage_review_started",
        "versioned_linkage_review_complete"
      ]
    },
    "promotion_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_continued_rule",
        "normalization",
        "non_promotion_rule"
      ],
      "properties": {
        "reviewed_continued_rule": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "non_promotion_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_relation_types": {
      "type": "array",
      "const": [
        "continued",
        "renamed_continuation",
        "merged_into_current",
        "split_into_current",
        "retired_after_first_plan",
        "new_in_second_plan",
        "unresolved"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_universe",
        "current_universe",
        "strong_rule_relation_count",
        "manual_reviewed_relation_count",
        "reviewed_relation_count",
        "reviewed_historical_identity_count",
        "reviewed_current_identity_count",
        "historical_without_reviewed_relation",
        "current_without_reviewed_relation",
        "exact_name_candidates_not_promoted"
      ],
      "properties": {
        "historical_universe": {
          "const": 360
        },
        "current_universe": {
          "const": 189
        },
        "reviewed_relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_historical_identity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        },
        "reviewed_current_identity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 189
        },
        "historical_without_reviewed_relation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        },
        "current_without_reviewed_relation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 189
        },
        "exact_name_candidates_not_promoted": {
          "type": "integer",
          "minimum": 0
        },
        "strong_rule_relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_reviewed_relation_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "not_promoted_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "quality_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "historical_review_ids",
        "current_review_ids",
        "review_basis",
        "review_status",
        "evidence"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "pattern": "^chiba-vl-[0-9]{3}$"
        },
        "relation_type": {
          "enum": [
            "continued",
            "renamed_continuation",
            "merged_into_current",
            "split_into_current",
            "retired_after_first_plan",
            "new_in_second_plan",
            "unresolved"
          ]
        },
        "historical_review_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^chiba-hf[0-9]{2}-p[0-9]{3}$"
          }
        },
        "current_review_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^chiba-f[0-9]{2}-p[0-9]{3}$"
          }
        },
        "review_status": {
          "const": "reviewed"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "review_basis": {
          "enum": [
            "strong_structural_rule",
            "manual_official_context_review"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_project_name",
        "current_project_name",
        "normalized_project_name",
        "historical_measure_code",
        "current_measure_code",
        "historical_responsible_departments",
        "current_responsible_departments",
        "overlapping_departments",
        "historical_source_id",
        "current_source_id",
        "historical_source_location",
        "current_source_location",
        "promotion_rule"
      ],
      "properties": {
        "historical_project_name": {
          "type": "string",
          "minLength": 1
        },
        "current_project_name": {
          "type": "string",
          "minLength": 1
        },
        "normalized_project_name": {
          "type": "string",
          "minLength": 1
        },
        "historical_measure_code": {
          "type": "string",
          "minLength": 1
        },
        "current_measure_code": {
          "type": "string",
          "minLength": 1
        },
        "historical_responsible_departments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_responsible_departments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlapping_departments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "historical_source_id": {
          "const": "chiba-implementation-plan-2023-2025-full-pdf"
        },
        "current_source_id": {
          "const": "chiba-implementation-plan-2026-2028-full-pdf"
        },
        "historical_source_location": {
          "type": "string",
          "minLength": 1
        },
        "current_source_location": {
          "type": "string",
          "minLength": 1
        },
        "promotion_rule": {
          "enum": [
            "normalized_name_equal_and_measure_equal_and_department_overlap",
            "manual_official_context_review"
          ]
        },
        "manual_review_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_review_id",
        "current_review_id",
        "historical_project_name",
        "current_project_name",
        "normalized_name_equal",
        "measure_equal",
        "overlapping_departments",
        "decision",
        "reason"
      ],
      "properties": {
        "historical_review_id": {
          "type": "string"
        },
        "current_review_id": {
          "type": "string"
        },
        "historical_project_name": {
          "type": "string"
        },
        "current_project_name": {
          "type": "string"
        },
        "normalized_name_equal": {
          "const": true
        },
        "measure_equal": {
          "type": "boolean"
        },
        "overlapping_departments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "const": "not_promoted"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
