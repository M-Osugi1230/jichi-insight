{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Shizuoka maximum-depth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "prefecture_code",
    "source_catalog",
    "normalizer",
    "shared_normalizer",
    "record_schema",
    "expected_normalization",
    "source_document_inventory",
    "source_document_summary",
    "maximum_depth_rule",
    "plan_history_boundary",
    "raw_statement_boundaries",
    "non_goals",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-shizuoka-normalization"},
    "phase": {"const": 11},
    "status": {"const": "reviewed_maximum_depth"},
    "prefecture_code": {"const": "22"},
    "source_catalog": {"const": "data/reviewed/phase9/22.json"},
    "normalizer": {"const": "scripts/normalize_phase11_shizuoka.py"},
    "shared_normalizer": {"const": "scripts/phase11_phase9_raw.py"},
    "record_schema": {"const": "schemas/phase11_record_linkage.schema.json"},
    "expected_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "linked_record_count",
        "partial_record_count",
        "not_linked_record_count",
        "indicator_series_count",
        "source_document_count",
        "missing_unit_record_count",
        "annual_actual_available_count",
        "future_target_available_count",
        "reviewed_maximum_depth_record_count",
        "policy_achievement_assessment_count"
      ],
      "properties": {
        "record_count": {"const": 985},
        "linked_record_count": {"const": 0},
        "partial_record_count": {"const": 985},
        "not_linked_record_count": {"const": 0},
        "indicator_series_count": {"const": 985},
        "source_document_count": {"const": 2},
        "missing_unit_record_count": {"const": 208},
        "annual_actual_available_count": {"const": 0},
        "future_target_available_count": {"const": 0},
        "reviewed_maximum_depth_record_count": {"const": 985},
        "policy_achievement_assessment_count": {"const": 0}
      }
    },
    "source_document_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/source_document"}
    },
    "source_document_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_documents",
        "documents_with_reviewed_candidates",
        "documents_with_canonical_records",
        "reviewed_candidate_rows",
        "canonical_records",
        "unique_canonical_source_hashes",
        "pdf_table_row_records",
        "pdf_text_line_records"
      ],
      "properties": {
        "registered_documents": {"const": 2},
        "documents_with_reviewed_candidates": {"const": 2},
        "documents_with_canonical_records": {"const": 2},
        "reviewed_candidate_rows": {"const": 985},
        "canonical_records": {"const": 985},
        "unique_canonical_source_hashes": {"const": 2},
        "pdf_table_row_records": {"const": 660},
        "pdf_text_line_records": {"const": 325}
      }
    },
    "maximum_depth_rule": {"type": "string", "minLength": 180},
    "plan_history_boundary": {"type": "string", "minLength": 180},
    "raw_statement_boundaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 100}
    },
    "non_goals": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 35}
    },
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "sha256",
        "extracted_rows",
        "reviewed_candidate_rows",
        "canonical_records",
        "structural_count",
        "canonical_status"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 20},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.pref\\.shizuoka\\.jp/_res/projects/default_project/_page_/001/054/440/.+\\.pdf$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extracted_rows": {"type": "integer", "minimum": 1},
        "reviewed_candidate_rows": {"type": "integer", "minimum": 1},
        "canonical_records": {"type": "integer", "minimum": 1},
        "structural_count": {"type": "integer", "minimum": 1},
        "canonical_status": {"const": "used"}
      }
    }
  }
}
