{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jichi-insight.local/schemas/saitama_phase13_completion.schema.json",
  "title":"Saitama Phase 13 completion contract",
  "type":"object",
  "additionalProperties":false,
  "required":["id","phase","status","official_code","name_ja","completed_at","completion_depth","review_package","quality_gate","deferred_depth","completion_boundary"],
  "properties":{
    "id":{"const":"saitama-phase13-completion"},
    "phase":{"const":13},
    "status":{"const":"reviewed_complete"},
    "official_code":{"const":"111007"},
    "name_ja":{"const":"さいたま市"},
    "completed_at":{"type":"string","format":"date"},
    "completion_depth":{"const":"declared_review_package_v1"},
    "review_package":{
      "type":"object",
      "additionalProperties":false,
      "required":["policy_review_manifest_path","plan_review_path","source_catalog_path","current_project_universe_path","current_target_identity_completion_evidence_path","current_outcome_registry_path","current_outcome_evidence_path","fiscal_records_path","fiscal_evidence_path","counts"],
      "properties":{
        "policy_review_manifest_path":{"const":"data/catalog/saitama_phase13_policy_review_manifest.json"},
        "plan_review_path":{"const":"data/reviewed/saitama-city/plan_review.json"},
        "source_catalog_path":{"const":"data/catalog/saitama_phase13_sources.json"},
        "current_project_universe_path":{"const":"data/catalog/saitama_current_project_universe_registry.json"},
        "current_target_identity_completion_evidence_path":{"const":"data/evidence/saitama_current_project_target_identities_chapter52_evidence.json"},
        "current_outcome_registry_path":{"const":"data/catalog/saitama_current_outcome_indicator_registry.json"},
        "current_outcome_evidence_path":{"const":"data/evidence/saitama_current_outcome_indicator_evidence.json"},
        "fiscal_records_path":{"const":"data/reviewed/saitama-city/fiscal_records.json"},
        "fiscal_evidence_path":{"const":"data/reviewed/saitama-city/evidence_packets.json"},
        "counts":{
          "type":"object",
          "additionalProperties":false,
          "required":["current_project_identities","current_target_identities","policy_field_target_identities","quality_city_management_target_identities","target_value_projects_reviewed","target_value_records_reviewed","target_value_projects_deferred","target_value_identities_deferred","current_outcome_indicators","outcome_self_report_or_perception_lane","outcome_objective_or_administrative_lane","historical_displayed_project_occurrences","historical_unique_projects","historical_measures","priority_strategy_kpis","priority_strategy_above_baseline","priority_strategy_flat","priority_strategy_below_baseline","priority_strategy_actual_unavailable","fiscal_top_line_records"],
          "properties":{
            "current_project_identities":{"const":258},
            "current_target_identities":{"const":531},
            "policy_field_target_identities":{"const":451},
            "quality_city_management_target_identities":{"const":80},
            "target_value_projects_reviewed":{"const":12},
            "target_value_records_reviewed":{"const":22},
            "target_value_projects_deferred":{"const":246},
            "target_value_identities_deferred":{"const":509},
            "current_outcome_indicators":{"const":97},
            "outcome_self_report_or_perception_lane":{"const":62},
            "outcome_objective_or_administrative_lane":{"const":35},
            "historical_displayed_project_occurrences":{"const":370},
            "historical_unique_projects":{"const":299},
            "historical_measures":{"const":63},
            "priority_strategy_kpis":{"const":40},
            "priority_strategy_above_baseline":{"const":26},
            "priority_strategy_flat":{"const":2},
            "priority_strategy_below_baseline":{"const":11},
            "priority_strategy_actual_unavailable":{"const":1},
            "fiscal_top_line_records":{"const":3}
          }
        }
      }
    },
    "quality_gate":{
      "type":"object",
      "additionalProperties":false,
      "minProperties":10,
      "patternProperties":{"^[a-z0-9_]+$":{"const":true}}
    },
    "deferred_depth":{
      "type":"array",
      "minItems":4,
      "maxItems":4,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["id","status","boundary"],
        "properties":{
          "id":{"enum":["current-target-values-beyond-chapter01","outcome-exact-source-method-provenance","historical-current-versioned-project-linkage","project-outcome-causal-and-cross-city-comparability"]},
          "status":{"const":"deferred_not_required_for_v1_completion"},
          "count":{"type":"integer","minimum":0},
          "project_count":{"type":"integer","minimum":0},
          "boundary":{"type":"string","minLength":20}
        }
      }
    },
    "completion_boundary":{"type":"string","minLength":180}
  }
}