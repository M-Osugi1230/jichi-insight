{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/chiba_phase13_completion.schema.json",
  "title": "Chiba Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "chiba-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "121002"
    },
    "name_ja": {
      "const": "千葉市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "current_project_work_item_review_manifest_path",
        "historical_project_identity_review_manifest_path",
        "versioned_project_linkage_review_path",
        "policy_indicator_review_path",
        "policy_indicator_evidence_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/chiba_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/chiba-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/chiba_phase13_sources.json"
        },
        "current_project_work_item_review_manifest_path": {
          "const": "data/catalog/chiba_current_project_work_item_review_manifest.json"
        },
        "historical_project_identity_review_manifest_path": {
          "const": "data/catalog/chiba_historical_project_identity_review_manifest.json"
        },
        "versioned_project_linkage_review_path": {
          "const": "data/catalog/chiba_versioned_project_linkage_review.json"
        },
        "policy_indicator_review_path": {
          "const": "data/reviewed/chiba-city/current_policy_indicators.json"
        },
        "policy_indicator_evidence_path": {
          "const": "data/evidence/chiba_current_policy_indicators_evidence.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/chiba-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/chiba-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_project_identities",
            "current_work_items",
            "current_quantitative_policy_indicators",
            "current_overall_goal_indicators",
            "current_qualitative_constituent_factors_primary",
            "historical_project_identities",
            "historical_repost_occurrences",
            "versioned_reviewed_relations",
            "versioned_strong_rule_relations",
            "versioned_manual_relations",
            "historical_identities_without_reviewed_relation",
            "current_identities_without_reviewed_relation",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_project_identities": {
              "const": 189
            },
            "current_work_items": {
              "const": 406
            },
            "current_quantitative_policy_indicators": {
              "const": 40
            },
            "current_overall_goal_indicators": {
              "const": 1
            },
            "current_qualitative_constituent_factors_primary": {
              "const": 6
            },
            "historical_project_identities": {
              "const": 360
            },
            "historical_repost_occurrences": {
              "const": 68
            },
            "versioned_reviewed_relations": {
              "const": 66
            },
            "versioned_strong_rule_relations": {
              "const": 60
            },
            "versioned_manual_relations": {
              "const": 6
            },
            "historical_identities_without_reviewed_relation": {
              "const": 294
            },
            "current_identities_without_reviewed_relation": {
              "const": 123
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "versioned-linkage-beyond-reviewed-continuations",
              "current-cycle-annual-progress-publication",
              "fiscal-detail-project-linkage",
              "project-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "historical_count": {
            "type": "integer",
            "minimum": 0
          },
          "current_count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 200
    }
  }
}
