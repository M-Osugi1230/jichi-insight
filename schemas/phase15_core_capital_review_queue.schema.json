{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/phase15_core_capital_review_queue.schema.json",
  "title": "Phase 15 core-city and prefectural-capital record review queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "scope",
    "promotion_target",
    "predecessor_phase",
    "predecessor_completion_path",
    "review_depth",
    "quality_gate",
    "execution_queue",
    "blocked_source_inventories",
    "summary",
    "updated_at"
  ],
  "properties": {
    "id": {
      "const": "phase15-core-capital-review-queue"
    },
    "phase": {
      "const": 15
    },
    "status": {
      "enum": [
        "in_progress",
        "complete"
      ]
    },
    "scope": {
      "const": "core_cities_and_prefectural_capitals_record_review"
    },
    "promotion_target": {
      "const": "reviewed"
    },
    "predecessor_phase": {
      "const": 14
    },
    "predecessor_completion_path": {
      "const": "data/catalog/phase14_completion.json"
    },
    "review_depth": {
      "const": "declared_review_package_v1"
    },
    "quality_gate": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 70
      }
    },
    "execution_queue": {
      "type": "array",
      "minItems": 67,
      "maxItems": 67,
      "items": {
        "$ref": "#/$defs/queuedMunicipality"
      }
    },
    "blocked_source_inventories": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_review_queue_count",
        "reviewed_complete_count",
        "review_in_progress_count",
        "pending_record_review_count",
        "blocked_source_inventory_count",
        "next_official_code"
      ],
      "properties": {
        "eligible_review_queue_count": {
          "const": 67
        },
        "reviewed_complete_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67
        },
        "review_in_progress_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "pending_record_review_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67
        },
        "blocked_source_inventory_count": {
          "const": 0
        },
        "next_official_code": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "queuedMunicipality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_sequence",
        "phase14_sequence",
        "phase14_wave",
        "official_code",
        "name_ja",
        "prefecture_name_ja",
        "municipality_type",
        "roles",
        "status"
      ],
      "properties": {
        "review_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67
        },
        "phase14_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67
        },
        "phase14_wave": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "official_code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "name_ja": {
          "type": "string",
          "minLength": 2
        },
        "prefecture_name_ja": {
          "type": "string",
          "minLength": 3
        },
        "municipality_type": {
          "enum": [
            "city",
            "special_ward"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "core_city",
              "prefectural_capital"
            ]
          }
        },
        "status": {
          "enum": [
            "pending_record_review",
            "review_in_progress",
            "reviewed_complete"
          ]
        }
      }
    }
  }
}
