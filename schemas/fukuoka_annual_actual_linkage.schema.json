{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.example/schemas/fukuoka_annual_actual_linkage.schema.json",
  "title": "Fukuoka annual actual linkage index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "prefecture_code",
    "status",
    "source",
    "target_count",
    "part_files",
    "summary",
    "boundaries",
    "evaluation_status",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "fukuoka-prefecture-fy2024-annual-actual-linkage"},
    "prefecture_code": {"const": "40"},
    "status": {"const": "reviewed"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "official_owner",
        "reporting_period",
        "pdf_page_count",
        "observed_at"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 5},
        "url": {"type": "string", "format": "uri"},
        "official_owner": {"type": "string", "minLength": 5},
        "reporting_period": {"const": "令和6年度"},
        "pdf_page_count": {"const": 61},
        "observed_at": {"type": "string", "format": "date"}
      }
    },
    "target_count": {"const": 118},
    "part_files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fukuoka_annual_actual_linkage_part_0[1-4]\\.json$"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linked_target_count",
        "partial_target_count",
        "not_linked_target_count",
        "normalized_exact_match_count",
        "reviewed_alias_match_count",
        "revised_target_detected_count",
        "source_row_not_found_count"
      ],
      "properties": {
        "linked_target_count": {"const": 86},
        "partial_target_count": {"const": 12},
        "not_linked_target_count": {"const": 20},
        "normalized_exact_match_count": {"const": 88},
        "reviewed_alias_match_count": {"const": 10},
        "revised_target_detected_count": {"const": 12},
        "source_row_not_found_count": {"const": 20}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linked", "partial", "not_linked"],
      "properties": {
        "linked": {"type": "string", "minLength": 40},
        "partial": {"type": "string", "minLength": 40},
        "not_linked": {"type": "string", "minLength": 40}
      }
    },
    "evaluation_status": {"const": "not_assessed"},
    "updated_at": {"type": "string", "format": "date"}
  }
}
