{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/yokohama_phase13_completion.schema.json",
  "title": "Yokohama Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "yokohama-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "141003"
    },
    "name_ja": {
      "const": "横浜市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "policy_indicator_proposal_snapshot_path",
        "historical_final_review_summary_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/yokohama_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/yokohama-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/yokohama_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/yokohama_current_policy_structure.json"
        },
        "policy_indicator_proposal_snapshot_path": {
          "const": "data/catalog/yokohama_policy_monitoring_indicator_proposal_snapshot.json"
        },
        "historical_final_review_summary_path": {
          "const": "data/catalog/yokohama_prior_plan_final_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/yokohama-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/yokohama-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_policy_groups",
            "current_measure_groups",
            "cross_cutting_project_themes",
            "policy_monitoring_indicator_identities",
            "policy_monitoring_proposal_values",
            "policy_monitoring_final_values_deferred",
            "historical_source_reported_improvement_percent",
            "historical_source_reported_adjusted_target_achievement_percent",
            "fiscal_top_line_records"
          ],
          "properties": {
            "current_policy_groups": {
              "const": 14
            },
            "current_measure_groups": {
              "const": 33
            },
            "cross_cutting_project_themes": {
              "const": 3
            },
            "policy_monitoring_indicator_identities": {
              "const": 15
            },
            "policy_monitoring_proposal_values": {
              "const": 15
            },
            "policy_monitoring_final_values_deferred": {
              "const": 15
            },
            "historical_source_reported_improvement_percent": {
              "const": 90
            },
            "historical_source_reported_adjusted_target_achievement_percent": {
              "const": 79
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "final-booklet-detailed-indicator-review",
              "current-plan-annual-progress",
              "historical-current-policy-versioned-linkage",
              "fiscal-detail-policy-project-linkage",
              "policy-outcome-causal-and-cross-city-comparability"
            ]
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "policy_indicator_count": {
            "type": "integer",
            "minimum": 0
          },
          "measure_group_count": {
            "type": "integer",
            "minimum": 0
          },
          "historical_policy_count": {
            "type": "integer",
            "minimum": 0
          },
          "current_policy_group_count": {
            "type": "integer",
            "minimum": 0
          },
          "current_measure_group_count": {
            "type": "integer",
            "minimum": 0
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 250
    }
  }
}
