{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 Aichi normalization completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "wave",
    "prefecture_code",
    "status",
    "source_catalog",
    "normalizer",
    "record_schema",
    "regression_test",
    "official_verification",
    "summary",
    "completion_boundary",
    "updated_at"
  ],
  "properties": {
    "id": {"const": "phase11-aichi-normalization"},
    "phase": {"const": 11},
    "wave": {"const": "wave2-remaining-regional-anchors"},
    "prefecture_code": {"const": "23"},
    "status": {"const": "complete"},
    "source_catalog": {
      "const": "data/reviewed/aichi_policy_indicators.json"
    },
    "normalizer": {"const": "scripts/normalize_phase11_aichi.py"},
    "record_schema": {
      "const": "schemas/phase11_record_linkage.schema.json"
    },
    "regression_test": {
      "const": "tests/test_phase11_aichi_normalization.py"
    },
    "official_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_page_url",
        "verified_at",
        "latest_annual_report",
        "official_page_updated_at",
        "newer_annual_report_listed"
      ],
      "properties": {
        "official_page_url": {"type": "string", "format": "uri"},
        "verified_at": {"type": "string", "format": "date"},
        "latest_annual_report": {"const": "あいちレポート2025"},
        "official_page_updated_at": {"const": "2026-03-30"},
        "newer_annual_report_listed": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "unique_indicator_count",
        "indicator_series_count",
        "linked_current_series_count",
        "missing_current_series_count",
        "target_series_count",
        "repost_record_count",
        "target_revision_record_count",
        "policy_achievement_assessment_count",
        "ranking_eligible_record_count"
      ],
      "properties": {
        "record_count": {"const": 56},
        "unique_indicator_count": {"const": 54},
        "indicator_series_count": {"const": 62},
        "linked_current_series_count": {"const": 61},
        "missing_current_series_count": {"const": 1},
        "target_series_count": {"const": 29},
        "repost_record_count": {"const": 2},
        "target_revision_record_count": {"const": 1},
        "policy_achievement_assessment_count": {"const": 0},
        "ranking_eligible_record_count": {"const": 0}
      }
    },
    "completion_boundary": {"type": "string", "minLength": 300},
    "updated_at": {"type": "string", "format": "date"}
  }
}
