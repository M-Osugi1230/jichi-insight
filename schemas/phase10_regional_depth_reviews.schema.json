{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.example/schemas/phase10_regional_depth_reviews.schema.json",
  "title": "Phase 10 regional depth reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "batch_id",
    "region",
    "prefecture_codes",
    "dimensions",
    "records",
    "summary",
    "policy_achievement_assessment_status",
    "ranking_eligibility",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^phase10-[a-z0-9-]+-depth-reviews$"
    },
    "phase": {"const": 10},
    "status": {"const": "reviewed"},
    "batch_id": {"type": "string", "minLength": 3},
    "region": {
      "enum": [
        "北海道",
        "東北",
        "関東",
        "中部",
        "近畿",
        "中国",
        "四国",
        "九州・沖縄"
      ]
    },
    "prefecture_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/prefectureCode"}
    },
    "dimensions": {
      "type": "array",
      "const": [
        "annual_actuals",
        "budget",
        "settlement",
        "priority_projects",
        "audit"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 47,
      "items": {"$ref": "#/$defs/record"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefecture_count",
        "dimension_count",
        "reviewed_source_count",
        "dimension_reviewed_counts"
      ],
      "properties": {
        "prefecture_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 47
        },
        "dimension_count": {"const": 5},
        "reviewed_source_count": {
          "type": "integer",
          "minimum": 5,
          "maximum": 235
        },
        "dimension_reviewed_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annual_actuals",
            "budget",
            "settlement",
            "priority_projects",
            "audit"
          ],
          "properties": {
            "annual_actuals": {"type": "integer", "minimum": 1, "maximum": 47},
            "budget": {"type": "integer", "minimum": 1, "maximum": 47},
            "settlement": {"type": "integer", "minimum": 1, "maximum": 47},
            "priority_projects": {"type": "integer", "minimum": 1, "maximum": 47},
            "audit": {"type": "integer", "minimum": 1, "maximum": 47}
          }
        }
      }
    },
    "policy_achievement_assessment_status": {"const": "not_assessed"},
    "ranking_eligibility": {
      "const": "excluded_until_comparability_verified"
    },
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "prefectureCode": {
      "type": "string",
      "pattern": "^(0[1-9]|[1-3][0-9]|4[0-7])$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "official_owner",
        "reporting_period",
        "claim",
        "boundary"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "official_owner": {"type": "string", "minLength": 3},
        "reporting_period": {"type": "string", "minLength": 3},
        "claim": {"type": "string", "minLength": 20},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_actuals",
        "budget",
        "settlement",
        "priority_projects",
        "audit"
      ],
      "properties": {
        "annual_actuals": {"$ref": "#/$defs/source"},
        "budget": {"$ref": "#/$defs/source"},
        "settlement": {"$ref": "#/$defs/source"},
        "priority_projects": {"$ref": "#/$defs/source"},
        "audit": {"$ref": "#/$defs/source"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefecture_code",
        "name",
        "region",
        "sources",
        "next_linkage"
      ],
      "properties": {
        "prefecture_code": {"$ref": "#/$defs/prefectureCode"},
        "name": {"type": "string", "minLength": 2},
        "region": {
          "enum": [
            "北海道",
            "東北",
            "関東",
            "中部",
            "近畿",
            "中国",
            "四国",
            "九州・沖縄"
          ]
        },
        "sources": {"$ref": "#/$defs/sources"},
        "next_linkage": {"type": "string", "minLength": 20}
      }
    }
  }
}
