{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jichi-insight.local/schemas/kumamoto_phase13_completion.schema.json",
  "title": "Kumamoto Phase 13 completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "status",
    "official_code",
    "name_ja",
    "completed_at",
    "completion_depth",
    "review_package",
    "quality_gate",
    "deferred_depth",
    "completion_boundary"
  ],
  "properties": {
    "id": {
      "const": "kumamoto-phase13-completion"
    },
    "phase": {
      "const": 13
    },
    "status": {
      "const": "reviewed_complete"
    },
    "official_code": {
      "const": "431001"
    },
    "name_ja": {
      "const": "熊本市"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "completion_depth": {
      "const": "declared_review_package_v1"
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_review_manifest_path",
        "plan_review_path",
        "source_catalog_path",
        "policy_structure_path",
        "progress_review_path",
        "fiscal_records_path",
        "fiscal_evidence_path",
        "counts"
      ],
      "properties": {
        "policy_review_manifest_path": {
          "const": "data/catalog/kumamoto_phase13_policy_review_manifest.json"
        },
        "plan_review_path": {
          "const": "data/reviewed/kumamoto-city/plan_review.json"
        },
        "source_catalog_path": {
          "const": "data/catalog/kumamoto_phase13_sources.json"
        },
        "policy_structure_path": {
          "const": "data/catalog/kumamoto_current_policy_structure.json"
        },
        "progress_review_path": {
          "const": "data/catalog/kumamoto_current_progress_review_summary.json"
        },
        "fiscal_records_path": {
          "const": "data/reviewed/kumamoto-city/fiscal_records.json"
        },
        "fiscal_evidence_path": {
          "const": "data/reviewed/kumamoto-city/evidence_packets.json"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_layers",
            "visions",
            "fy2026_priority_items",
            "reviewed_current_evaluation_fiscal_years",
            "accountability_roles",
            "fiscal_top_line_records"
          ],
          "properties": {
            "plan_layers": {
              "const": 3
            },
            "visions": {
              "const": 8
            },
            "fy2026_priority_items": {
              "const": 4
            },
            "reviewed_current_evaluation_fiscal_years": {
              "const": 1
            },
            "accountability_roles": {
              "const": 2
            },
            "fiscal_top_line_records": {
              "const": 3
            }
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "const": true
        }
      }
    },
    "deferred_depth": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "const": "deferred_not_required_for_v1_completion"
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 300
    }
  }
}
